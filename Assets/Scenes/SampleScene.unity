  m_Script: {fileID: 11500000, guid: 17c4ca13811a2a440ab7ac3046b715ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ContextInteractable
  dialogueLines:
  - "The riverbed here's nearly bare \u2014 the water's barely dribbling over those
    rocks these days."
  - This stretch used to run fast enough to hear from the village gate. Now it's
    just a whisper.
  - "Even the reeds along the bank are wilting \u2014 they need more than what's
    trickling through now."
  - Whatever's blocking this up top, it's been getting worse by the day.
  interactSfx: {fileID: 8300000, guid: 9d7e0cfa3cb1b4046aa469a8b0ef2115, type: 3}
